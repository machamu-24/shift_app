<!DOCTYPE html>
<html>
  <head>
    <title>ShiftApp</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="container header-container">
        <%= link_to "ShiftApp", root_path, class: "logo" %>
        <nav class="main-nav">
          <% if logged_in? %>
            <div style="display: flex; align-items: center; gap: 1rem; margin-right: 1rem; color: var(--text-muted); font-size: 0.875rem;">
              <%= current_staff.name %> (<%= current_staff.admin? ? "管理者" : "一般" %>)
            </div>
            <%= link_to "シフト一覧", shift_months_path, class: "nav-link" %>
            <% if current_staff.admin? %>
              <%= link_to "スタッフ管理", staffs_path, class: "nav-link" %>
            <% end %>
            <%= button_to "ログアウト", logout_path, method: :delete, class: "nav-link", style: "background: none; border: none; cursor: pointer; padding: 0; font: inherit;" %>
          <% else %>
            <span class="nav-link">ログインしてください</span>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <div class="container">
        <div id="flash">
          <%= render "layouts/flash" %>
        </div>
        <%= yield %>
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; <%= Time.current.year %> ShiftApp</p>
      </div>
    </footer>
  </body>
</html>
