<div style="max-width: 600px; margin: 0 auto;">
  <div class="flex justify-between items-center mb-4">
    <h1 style="margin-bottom: 0; font-size: 1.5rem;">プロフィール編集</h1>
    <%= link_to "戻る", shift_months_path, class: "button secondary", style: "font-size: 0.875rem; padding: 0.25rem 0.75rem;" %>
  </div>

  <div class="card">
    <%= form_with model: @staff, url: profile_path, local: true do |f| %>
      <% if @staff.errors.any? %>
        <div class="alert alert-alert mb-4">
          <ul style="margin: 0; padding-left: 1.5rem;">
            <% @staff.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.label :name, "氏名" %>
        <%= f.text_field :name, class: "form-control", style: "width: 100%; box-sizing: border-box; padding: 0.5rem;" %>
      </div>

      <div class="form-group">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, class: "form-control", style: "width: 100%; box-sizing: border-box; padding: 0.5rem;" %>
      </div>

      <hr style="margin: 2rem 0; border: 0; border-top: 1px solid var(--border-color);">

      <h3 style="font-size: 1.1rem; margin-bottom: 1rem;">パスワード変更</h3>
      <p style="font-size: 0.875rem; color: var(--text-muted); margin-bottom: 1rem;">
        パスワードを変更する場合のみ入力してください。
      </p>

      <div class="form-group">
        <%= f.label :password, "新しいパスワード" %>
        <%= f.password_field :password, class: "form-control", style: "width: 100%; box-sizing: border-box; padding: 0.5rem;" %>
      </div>

      <div class="form-group">
        <%= f.label :password_confirmation, "新しいパスワード（確認）" %>
        <%= f.password_field :password_confirmation, class: "form-control", style: "width: 100%; box-sizing: border-box; padding: 0.5rem;" %>
      </div>

      <div style="margin-top: 2rem;">
        <%= f.submit "保存する", class: "button", style: "width: 100%; padding: 0.75rem;" %>
      </div>
    <% end %>
  </div>
</div>
