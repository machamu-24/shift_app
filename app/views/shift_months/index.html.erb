<div class="flex justify-between items-center mb-4">
  <h1 style="margin-bottom: 0;">シフト一覧</h1>
  <% if current_staff.admin? %>
    <%= link_to "新規作成", new_shift_month_path, class: "button" %>
  <% end %>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem;">
  <% @shift_months.each do |sm| %>
    <%
      border_color = case sm.status_color
                     when "status-confirmed" then "#10b981"
                     when "status-generated" then "#f59e0b"
                     else                         "#9ca3af"
                     end
    %>
    <div class="card" style="display: block; position: relative; border-left: 4px solid <%= border_color %>;">
      <%= link_to shift_month_path(sm), style: "display: block; color: inherit; text-decoration: none; transition: transform 0.2s; padding-bottom: 2rem;" do %>
        <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 0.75rem;">
          <span style="font-size: 1.5rem; font-weight: 700; color: var(--text-main);">
            <%= sm.year %>年 <span style="font-size: 2rem;"><%= sm.month %></span>月
          </span>
          <%
            badge_style = case sm.status_color
                          when "status-confirmed"
                            "background-color: #d1fae5; color: #065f46; border: 1px solid #6ee7b7;"
                          when "status-generated"
                            "background-color: #fef3c7; color: #92400e; border: 1px solid #fcd34d;"
                          else
                            "background-color: #f3f4f6; color: #6b7280; border: 1px solid #d1d5db;"
                          end
          %>
          <span style="font-size: 0.75rem; font-weight: 600; padding: 0.25rem 0.6rem; border-radius: 9999px; <%= badge_style %>">
            <%= sm.status_label %>
          </span>
        </div>
        <% if sm.request_deadline.present? %>
          <div style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem;">
            希望休締め切り: <%= sm.request_deadline.strftime("%m/%d") %>
            <% if sm.request_deadline_passed? %>
              <span style="color: #dc2626; font-weight: 600;">(締め切り済み)</span>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% if current_staff.admin? %>
        <div style="position: absolute; bottom: 1rem; right: 1rem;">
          <%= button_to "削除", shift_month_path(sm), method: :delete, class: "button danger", style: "padding: 0.4rem 0.8rem; font-size: 0.8rem;", form: { data: { turbo_confirm: "#{sm.year}年#{sm.month}月のシフトデータを削除しますか？" } } %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
