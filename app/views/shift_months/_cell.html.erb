<%# locals: shift_month:, staff:, date:, assignment:, requested_off_map:, assignment_map: %>
<% max_consecutive = ShiftGenerator::MAX_CONSECUTIVE_WORK %>

<% current_kind = assignment&.kind || "D" %>
<% next_kind = (current_kind == "D" ? "O" : "D") %>

<% requested_off = requested_off_map&.dig(staff.id, date) == true %>

<% label = (current_kind == "O" ? "休" : "") %>

<% confirm_messages = [] %>

<% if next_kind == "D" %>
  <% if requested_off %>
    <% confirm_messages << "出勤日に変更しても良いですか？" %>
  <% end %>

  <% span = consecutive_work_span_if_set_to_work(assignment_map, staff.id, date) %>
  <% if span > max_consecutive %>
    <% confirm_messages << "最大連勤#{max_consecutive}日を超えます（#{span}連勤）。変更しても良いですか？" %>
  <% end %>
<% end %>

<% confirm_message = confirm_messages.any? ? confirm_messages.join("\n") : nil %>
<%
  label_class = if current_kind == "D" || current_kind.blank?
                  "is-work"
                elsif current_kind == "O"
                  "is-off"
                else
                  "is-special"
                end
  label_text = ShiftAssignment::HUMAN_KINDS[current_kind]
%>

<%= turbo_frame_tag dom_id_for_cell(shift_month, staff, date), style: "display: block; width: 100%; height: 100%;" do %>
  <div class="calendar-cell-wrapper">
    <div class="calendar-cell-label <%= label_class %>">
      <%= label_text %>
    </div>
    
    <%= form_with url: toggle_assignment_shift_month_path(shift_month), method: :post, data: { turbo: true }, style: "position: absolute; top:0; left:0; width:100%; height:100%;" do |f| %>
      <%= f.hidden_field :staff_id, value: staff.id %>
      <%= f.hidden_field :date, value: date.to_s %>
      <% js_submit = confirm_message.present? ? "if(confirm('#{escape_javascript(confirm_message)}')) { this.form.requestSubmit(); } else { this.value = '#{escape_javascript(current_kind)}'; }" : "this.form.requestSubmit();" %>
      <%= f.select :kind,
            ShiftAssignment::HUMAN_KINDS.map { |k, v| [v.presence || "出", k] },
            { selected: current_kind },
            class: "calendar-cell-hidden-select",
            onchange: js_submit %>
    <% end %>
  </div>
<% end %>
