

<div class="card">
  <div class="flex justify-between items-center mb-4">
    <div>
      <h1 style="margin-bottom: 0.5rem;"><%= @shift_month.year %>年 <%= @shift_month.month %>月</h1>
      <div style="color: var(--text-muted); display: flex; align-items: center; gap: 1rem;">
        <span>ステータス: <span style="font-weight: 600;"><%= @shift_month.status %></span></span>
        <% if @shift_month.is_confirmed %>
           <span style="color: var(--danger-color); font-weight: 700;">🔒 確定済み（編集ロック）</span>
        <% else %>
           <span style="color: var(--success-color); font-weight: 700;">🖊️ 編集中（入力可）</span>
        <% end %>
      </div>
    </div>
    <div style="display: flex; gap: 0.5rem;">
      <%= link_to "希望休申請へ", shift_month_my_requests_path(@shift_month), class: "button", style: "background-color: var(--accent-color);" %>
      
      <% if current_staff.admin? %>
        <%= button_to @shift_month.is_confirmed ? "確定解除（ロック解除）" : "シフト確定（ロック）", confirm_shift_month_path(@shift_month), method: :patch, class: "button", style: "background-color: #{@shift_month.is_confirmed ? 'var(--text-muted)' : 'var(--danger-color)'};" %>
        <%= link_to "条件を編集", edit_shift_month_path(@shift_month), class: "button secondary" %>
      <% end %>
    </div>
  </div>
  
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; padding: 1rem; background: var(--background-bg); border-radius: var(--radius-md);">
    <div>
      <div style="font-size: 0.875rem; color: var(--text-muted);">平日必要人数</div>
      <div style="font-size: 1.25rem; font-weight: 700;"><%= @shift_month.required_day_shifts_weekday %>名</div>
    </div>
    <div>
      <div style="font-size: 0.875rem; color: var(--text-muted);">日・祝必要人数</div>
      <div style="font-size: 1.25rem; font-weight: 700;"><%= @shift_month.required_day_shifts_sun_holiday %>名</div>
    </div>
    <div>
      <div style="font-size: 0.875rem; color: var(--text-muted);">連勤上限</div>
      <div style="font-size: 1.25rem; font-weight: 700;"><%= @shift_month.max_consecutive_work_days %>日</div>
    </div>
    <%
      base_holidays = @dates.count { |d| d.saturday? || d.sunday? || HolidayJapan.check(d) }
    %>
    <div>
      <div style="font-size: 0.875rem; color: var(--text-muted);">基本休日（土日祝）</div>
      <div style="font-size: 1.25rem; font-weight: 700; color: var(--accent-color);"><%= base_holidays %>日</div>
    </div>
  </div>
</div>

<% if @error_message.present? %>
  <div class="alert alert-alert mb-4">
    <h3 style="margin-top: 0; color: #991b1b;"><%= @error_message %></h3>
    <% if @shortages.any? %>
      <ul style="margin-bottom: 0; padding-left: 1.5rem;">
        <% @shortages.first(5).each do |s| %>
          <li>
            <%= s["date"] %>：必要 <%= s["required"] %>名 / 可能 <%= s["available"] %>名（不足 <strong><%= s["shortage"] %></strong>名）
          </li>
        <% end %>
        <% if @shortages.size > 5 %>
          <li>ほか <%= @shortages.size - 5 %> 日</li>
        <% end %>
      </ul>
    <% end %>
  </div>
<% end %>

<% if current_staff.admin? %>
<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
  <div class="card" style="margin-bottom: 0;">
    <h2>希望休（必須）を追加</h2>
    <%= form_with model: [@shift_month, @shift_request], local: true do |f| %>
      <div class="form-group">
        <%= f.label :staff_id, "スタッフ" %>
        <%= f.collection_select :staff_id, @staffs, :id, :name, { prompt: "選択してください" } %>
      </div>

      <div class="form-group">
        <%= f.label :date, "日付" %>
        <%= f.date_field :date,
            min: Date.new(@shift_month.year, @shift_month.month, 1),
            max: Date.new(@shift_month.year, @shift_month.month, 1).end_of_month %>
      </div>

      <div style="margin-top: 1.5rem;">
        <%= f.submit "希望休を追加", class: "button", style: "width: 100%;" %>
      </div>
    <% end %>
  </div>

  <div class="card" style="margin-bottom: 0;">
    <h2>登録済み希望休</h2>
    <% if @requests.empty? %>
      <p style="color: var(--text-muted);">まだ登録がありません。</p>
    <% else %>
      <div style="max-height: 300px; overflow-y: auto;">
        <table>
          <thead>
            <tr>
              <th>日付</th>
              <th>スタッフ</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @requests.each do |r| %>
              <tr>
                <td><%= r.date %></td>
                <td><%= r.staff.name %></td>
                <td style="text-align: right;">
                  <%= button_to "削除", shift_month_shift_request_path(@shift_month, r),
                        method: :delete,
                        class: "button danger",
                        style: "padding: 0.25rem 0.5rem; font-size: 0.75rem;",
                        data: { turbo_confirm: "削除しますか？" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
<% end %>

<div class="card">
  <div class="flex justify-between items-center mb-4">
    <h2 style="margin: 0;">勤務表（カレンダー）</h2>
    <div class="flex gap-2">
      <% if current_staff.admin? %>
        <%= button_to "シフトを自動生成", generate_shift_month_path(@shift_month), method: :post, class: "button" %>
      <% end %>
      <%= link_to "CSV出力", export_csv_shift_month_path(@shift_month), class: "button secondary", data: { turbo: false } %>
      <%= link_to "PDF出力", export_pdf_shift_month_path(@shift_month), class: "button secondary", data: { turbo: false } %>
    </div>
  </div>

  <% has_assignments = @assignment_map.values.any? { |by_date| by_date.present? } %>

  <% if !has_assignments %>
    <p style="text-align: center; padding: 2rem; color: var(--text-muted);">シフトはまだ生成されていません。「シフトを自動生成」ボタンを押してください。</p>
  <% else %>
    <!-- CALENDAR START -->
    <div class="shift-calendar-wrapper">
      <table class="shift-calendar" border="1" cellpadding="6">
        <thead>
          <tr>
          <th>名前</th>
            <% @dates.each do |date| %>
              <th class="<%= date_header_class(date) %>" title="<%= holiday_name(date) %>">
                <div><%= date.day %></div>
                <div style="font-size: 12px;"><%= %w(日 月 火 水 木 金 土)[date.wday] %></div>
              </th>
            <% end %>
            <th style="min-width: 60px;">休日<br>合計</th>
            <th style="min-width: 60px;">年休・<br>厚休</th>
          </tr>
        </thead>

        <tbody>
          <% @staffs.each do |staff| %>
            <%= render partial: "shift_months/row",
                  locals: {
                    shift_month: @shift_month,
                    staff: staff,
                    dates: @dates,
                    assignment_map: @assignment_map,
                    requested_off_map: @requested_off_map
                  } %>
          <% end %>

          <tr class="summary-row summary-work-row">
            <td class="summary-label">出勤</td>
            <% @dates.each do |date| %>
              <% assignments_for_date = @staffs.map { |s| @assignment_map.dig(s.id, date)&.kind || "D" } %>
              <% working_count = assignments_for_date.count { |k| k == "D" } %>
              <td class="summary-work">
                <%= working_count %>
              </td>
            <% end %>
            <td colspan="2" style="background-color: #f8f9fa;"></td>
          </tr>

          <tr class="summary-row summary-off-row">
            <td class="summary-label">休み</td>
            <% @dates.each do |date| %>
              <% assignments_for_date = @staffs.map { |s| @assignment_map.dig(s.id, date)&.kind || "D" } %>
              <% off_count = assignments_for_date.count { |k| k != "D" } %>
              <td class="summary-off">
                <%= off_count %>
              </td>
            <% end %>
            <td colspan="2" style="background-color: #f8f9fa;"></td>
          </tr>
        </tbody>
      </table>
    </div>
    <!-- CALENDAR END -->
  <% end %>
</div>
