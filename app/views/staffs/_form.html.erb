<%= form_with model: staff, local: true do |f| %>
  <div class="form-group">
    <%= f.label :name, "氏名" %>
    <%= f.text_field :name %>
  </div>

  <div class="form-group">
    <%= f.label :active, "稼働（シフト対象）", style: "display: inline-block; margin-right: 0.5rem;" %>
    <%= f.check_box :active, style: "width: auto; display: inline-block;" %>
  </div>

  <div class="form-group">
    <%= f.label :is_leader, "リーダー", style: "display: inline-block; margin-right: 0.5rem;" %>
    <%= f.check_box :is_leader, style: "width: auto; display: inline-block;" %>
  </div>

  <hr style="margin: 2rem 0; border: 0; border-top: 1px solid var(--border-color);">

  <h3 style="font-size: 1.1rem; margin-bottom: 1rem;">ログイン・権限情報</h3>

  <div class="form-group">
    <%= f.label :role, "権限" %>
    <div style="display: flex; gap: 1.5rem;">
      <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
        <%= f.radio_button :role, :general %>
        <span>一般</span>
      </label>
      <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
        <%= f.radio_button :role, :admin %>
        <span>管理者</span>
      </label>
    </div>
  </div>

  <div class="form-group">
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email, class: "form-control", style: "width: 100%; box-sizing: border-box; padding: 0.5rem;" %>
  </div>

  <div class="form-group">
    <%= f.label :password, "パスワード" %>
    <% if staff.persisted? %>
      <div style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.5rem;">※変更する場合のみ入力してください</div>
    <% end %>
    <%= f.password_field :password, class: "form-control", style: "width: 100%; box-sizing: border-box; padding: 0.5rem;" %>
  </div>

  <div class="form-group">
    <%= f.label :password_confirmation, "パスワード（確認）" %>
    <%= f.password_field :password_confirmation, class: "form-control", style: "width: 100%; box-sizing: border-box; padding: 0.5rem;" %>
  </div>

  <div class="actions flex gap-2" style="margin-top: 2rem;">
    <%= f.submit class: "button" %>
    <%= link_to "一覧へ戻る", staffs_path, class: "button secondary" %>
  </div>
<% end %>
