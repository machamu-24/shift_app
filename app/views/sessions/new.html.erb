<div style="max-width: 400px; margin: 4rem auto; padding: 2rem; background: var(--surface-bg); border-radius: var(--radius-md); box-shadow: var(--shadow-md);">
  <h1 style="text-align: center; margin-bottom: 2rem;">ログイン</h1>

  <%= form_with url: login_path, local: true do |f| %>
    <div class="form-group">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, placeholder: "staff_ID@example.com", required: true %>
    </div>

    <div class="form-group">
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password, required: true %>
    </div>

    <div style="margin-top: 2rem;">
      <%= f.submit "ログイン", class: "button", style: "width: 100%;" %>
    </div>
  <% end %>
</div>
